# WSO2 Asgardeo Application Configuration
# Obtain these values from the WSO2 Asgardeo Console (https://console.asgardeo.io)
# Under Applications -> [Your Single Page Application] -> Info / Protocol

# Client ID generated by Asgardeo for your SPA
VITE_ASGARDEO_CLIENT_ID=<YOUR_CLIENT_ID>

# Base URL formatted as https://api.asgardeo.io/t/<YOUR_ORGANIZATION_NAME>
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<YOUR_ORGANIZATION_NAME>

# Authorized Redirect URL (must match the Redirect URL registered in Asgardeo)
VITE_ASGARDEO_REDIRECT_URL=http://localhost:5173

# Post Logout Redirect URL (must match the Sign-out Redirect URL in Asgardeo)
VITE_ASGARDEO_POST_LOGOUT_URL=http://localhost:5173
